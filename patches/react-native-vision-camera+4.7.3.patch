+import android.opengl.EGL14;
+import android.opengl.EGLExt;
+import android.opengl.GLES20;
+import android.view.Surface;
+
+import androidx.annotation.NonNull;
+import androidx.camera.core.processing.OpenGlRenderer;
+import androidx.camera.core.processing.util.GLUtils.Program2D;
+import androidx.camera.core.processing.util.GLUtils.SamplerShaderProgram;
+
+public class FocusPeakingOpenGlRenderer extends OpenGlRenderer {
+  private volatile boolean peakingEnabled;
+  private volatile float peakingSensitivity;
+  private volatile float texelWidth = 1.0f / 1280.0f;
+  private volatile float texelHeight = 1.0f / 720.0f;
+  private int lastProgramHandle = -1;
+  private int enabledLocation = -1;
+  private int sensitivityLocation = -1;
+  private int texelWidthLocation = -1;
+  private int texelHeightLocation = -1;
+
+  public FocusPeakingOpenGlRenderer(boolean enabled, float sensitivity) {
+    setPeakingParameters(enabled, sensitivity);
+  }
+
+  public void setPeakingParameters(boolean enabled, float sensitivity) {
+    peakingEnabled = enabled;
+    peakingSensitivity = Math.max(0.0f, Math.min(1.0f, sensitivity));
+  }
+
+  public void setInputSize(int width, int height) {
+    texelWidth = 1.0f / Math.max(width, 1);
+    texelHeight = 1.0f / Math.max(height, 1);
+  }
+
+  @Override
+  public void render(long timestampNs, @NonNull float[] textureTransform, @NonNull Surface surface) {
+    checkInitializedOrThrow(mInitialized, true);
+    checkGlThreadOrThrow(mGlThread);
+
+    OutputSurface outputSurface = getOutSurfaceOrThrow(surface);
+    if (outputSurface == NO_OUTPUT_SURFACE) {
+      outputSurface = createOutputSurfaceInternal(surface);
+      if (outputSurface == null) {
+        return;
+      }
+      mOutputSurfaceMap.put(surface, outputSurface);
+    }
+
+    if (surface != mCurrentSurface) {
+      makeCurrent(outputSurface.getEglSurface());
+      mCurrentSurface = surface;
+      GLES20.glViewport(0, 0, outputSurface.getWidth(), outputSurface.getHeight());
+      GLES20.glScissor(0, 0, outputSurface.getWidth(), outputSurface.getHeight());
+    }
+
+    Program2D program = mCurrentProgram;
+    if (program == null) {
+      return;
+    }
+    if (program instanceof SamplerShaderProgram) {
+      ((SamplerShaderProgram) program).updateTextureMatrix(textureTransform);
+    }
+    updatePeakingUniforms(program);
+
+    GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4);
+    checkGlErrorOrThrow("glDrawArrays");
+
+    EGLExt.eglPresentationTimeANDROID(mEglDisplay, outputSurface.getEglSurface(), timestampNs);
+    if (!EGL14.eglSwapBuffers(mEglDisplay, outputSurface.getEglSurface())) {
+      removeOutputSurfaceInternal(surface, false);
+    }
+  }
+
+  private void updatePeakingUniforms(@NonNull Program2D program) {
+    int programHandle = program.mProgramHandle;
+    if (programHandle != lastProgramHandle) {
+      lastProgramHandle = programHandle;
+      enabledLocation = GLES20.glGetUniformLocation(programHandle, "uPeakingEnabled");
+      sensitivityLocation = GLES20.glGetUniformLocation(programHandle, "uPeakingSensitivity");
+      texelWidthLocation = GLES20.glGetUniformLocation(programHandle, "uTexelWidth");
+      texelHeightLocation = GLES20.glGetUniformLocation(programHandle, "uTexelHeight");
+    }
+
+    if (enabledLocation >= 0) {
+      GLES20.glUniform1f(enabledLocation, peakingEnabled ? 1.0f : 0.0f);
+    }
+    if (sensitivityLocation >= 0) {
+      GLES20.glUniform1f(sensitivityLocation, peakingSensitivity);
+    }
+    if (texelWidthLocation >= 0) {
+      GLES20.glUniform1f(texelWidthLocation, texelWidth);
+    }
+    if (texelHeightLocation >= 0) {
+      GLES20.glUniform1f(texelHeightLocation, texelHeight);
+    }
+    checkGlErrorOrThrow("focus peaking uniforms");
+  }
+}
