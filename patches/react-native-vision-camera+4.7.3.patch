+@OptIn(ExperimentalCamera2Interop::class)
+internal fun CameraSession.applyStabilizationCaptureRequestOptions(config: CameraConfiguration) {
+  val camera = camera ?: return
+  val camera2Info = try {
+    Camera2CameraInfo.from(camera.cameraInfo)
+  } catch (_: RuntimeException) {
+    return
+  }
+  val camera2Control = try {
+    Camera2CameraControl.from(camera.cameraControl)
+  } catch (_: RuntimeException) {
+    return
+  }
+  val characteristics = try {
+    Camera2CameraInfo.extractCameraCharacteristics(camera.cameraInfo)
+  } catch (_: RuntimeException) {
+    null
+  }
+
+  var hasOptions = false
+  val builder = CaptureRequestOptions.Builder()
+  val videoStabilizationModes = camera2Info.getCameraCharacteristic(
+    CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES
+  )
+  val videoStabilizationMode = getVideoStabilizationRequestMode(
+    videoStabilizationModes,
+    config.videoStabilizationMode
+  )
+  if (videoStabilizationMode != null) {
+    builder.setCaptureRequestOption(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, videoStabilizationMode)
+    hasOptions = true
+  }
+
+  // Only touch OIS when stabilization is requested — forcing it in the
+  // non-stabilized configuration deviates from stock behavior and can upset
+  // vendor ISP pipelines.
+  if (config.videoStabilizationMode.isAtLeast(VideoStabilizationMode.STANDARD)) {
+    val opticalStabilizationModes = camera2Info.getCameraCharacteristic(
+      CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION
+    )
+    if (opticalStabilizationModes?.contains(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON) == true) {
+      builder.setCaptureRequestOption(
+        CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
+        CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON
+      )
+      hasOptions = true
+    }
+  }
+  if (characteristics != null && configureVendorStabilizationCaptureRequestOptions(
+      builder,
+      characteristics,
+      config.videoStabilizationMode
+    )
+  ) {
+    hasOptions = true
+  }
+
+  if (hasOptions) {
+    if (!config.videoStabilizationMode.isAtLeast(VideoStabilizationMode.STANDARD)) {
+      // Stabilization is off: drop any vendor/OIS keys left over from a
+      // previous stabilized configuration instead of overwriting them with 0.
+      camera2Control.clearCaptureRequestOptions()
+    }
+    camera2Control.addCaptureRequestOptions(builder.build())
+  }
+}
+
+@OptIn(ExperimentalCamera2Interop::class)
+private fun <T> CameraSession.configureStabilizationCaptureRequestOptions(
+  extender: Camera2Interop.Extender<T>,
+  config: CameraConfiguration
+) {
+  val characteristics = getCameraCharacteristics(config.cameraId) ?: return
+  val videoStabilizationMode = getVideoStabilizationRequestMode(
+    characteristics.get(CameraCharacteristics.CONTROL_AVAILABLE_VIDEO_STABILIZATION_MODES),
+    config.videoStabilizationMode
+  )
+  if (videoStabilizationMode != null) {
+    extender.setCaptureRequestOption(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE, videoStabilizationMode)
+  }
+  configureStreamUseCase(extender, characteristics, config.videoStabilizationMode)
+
+  if (config.videoStabilizationMode.isAtLeast(VideoStabilizationMode.STANDARD)) {
+    val opticalStabilizationModes = characteristics.get(CameraCharacteristics.LENS_INFO_AVAILABLE_OPTICAL_STABILIZATION)
+    if (opticalStabilizationModes?.contains(CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON) == true) {
+      extender.setCaptureRequestOption(
+        CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
+        CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_ON
+      )
+    }
+  }
+  configureVendorStabilizationCaptureRequestOptions(extender, characteristics, config.videoStabilizationMode)
+}
+
+@OptIn(ExperimentalCamera2Interop::class)
+private fun <T> configureStreamUseCase(
+  extender: Camera2Interop.Extender<T>,
+  characteristics: CameraCharacteristics,
+  requestedMode: VideoStabilizationMode
+) {
+  if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU || !requestedMode.isAtLeast(VideoStabilizationMode.STANDARD)) {
+    return
+  }
+
+  val availableStreamUseCases = characteristics.get(CameraCharacteristics.SCALER_AVAILABLE_STREAM_USE_CASES) ?: return
+  val preferredStreamUseCases = longArrayOf(
+    CameraMetadata.SCALER_AVAILABLE_STREAM_USE_CASES_PREVIEW_VIDEO_STILL.toLong(),
+    CameraMetadata.SCALER_AVAILABLE_STREAM_USE_CASES_PREVIEW.toLong(),
+    CameraMetadata.SCALER_AVAILABLE_STREAM_USE_CASES_VIDEO_RECORD.toLong()
+  )
+  val streamUseCase = preferredStreamUseCases.firstOrNull { availableStreamUseCases.contains(it) } ?: return
+  extender.setStreamUseCase(streamUseCase)
+}
+
+private fun configureVendorStabilizationCaptureRequestOptions(
+  builder: CaptureRequestOptions.Builder,
+  characteristics: CameraCharacteristics,
+  requestedMode: VideoStabilizationMode
+): Boolean {
+  // Vendor keys are only written when enabling stabilization. Writing 0 into
+  // vendor session parameters is not what stock camera apps do and has been
+  // observed to leave some vendor ISP pipelines in a bad state (e.g. inverted
+  // preview colors); leaving the keys untouched keeps the HAL defaults.
+  if (!requestedMode.isAtLeast(VideoStabilizationMode.STANDARD)) return false
+  var hasOptions = false
+
+  if (characteristics.supportsCaptureRequestKey(QCOM_EIS_MODE_KEY_NAME)) {
+    builder.setCaptureRequestOption(qcomEisModeKey, 1)
+    hasOptions = true
+  }
+  if (characteristics.supportsCaptureRequestKey(SAMSUNG_SW_VIDEO_STABILIZATION_KEY_NAME)) {
+    builder.setCaptureRequestOption(samsungSwVideoStabilizationKey, 1.toByte())
+    hasOptions = true
+  }
+  if (characteristics.supportsCaptureRequestKey(SAMSUNG_OIS_OPERATION_MODE_KEY_NAME)) {
+    builder.setCaptureRequestOption(samsungOisOperationModeKey, 1)
+    hasOptions = true
+  }
+
+  return hasOptions
+}
+
+@OptIn(ExperimentalCamera2Interop::class)
+private fun <T> configureVendorStabilizationCaptureRequestOptions(
+  extender: Camera2Interop.Extender<T>,
+  characteristics: CameraCharacteristics,
+  requestedMode: VideoStabilizationMode
+) {
+  if (!requestedMode.isAtLeast(VideoStabilizationMode.STANDARD)) return
+  if (characteristics.supportsCaptureRequestKey(QCOM_EIS_MODE_KEY_NAME)) {
+    extender.setCaptureRequestOption(qcomEisModeKey, 1)
+  }
+  if (characteristics.supportsCaptureRequestKey(SAMSUNG_SW_VIDEO_STABILIZATION_KEY_NAME)) {
+    extender.setCaptureRequestOption(samsungSwVideoStabilizationKey, 1.toByte())
+  }
+  if (characteristics.supportsCaptureRequestKey(SAMSUNG_OIS_OPERATION_MODE_KEY_NAME)) {
+    extender.setCaptureRequestOption(samsungOisOperationModeKey, 1)
+  }
+}
+
+private fun CameraSession.getCameraCharacteristics(cameraId: String?): CameraCharacteristics? {
+  if (cameraId == null) return null
+  return try {
+    val cameraManager = context.getSystemService(Context.CAMERA_SERVICE) as CameraManager
+    cameraManager.getCameraCharacteristics(cameraId)
+  } catch (_: Throwable) {
+    null
+  }
+}
+
+private fun CameraCharacteristics.supportsCaptureRequestKey(name: String): Boolean {
+  val requestKeySupported = availableCaptureRequestKeys.any { it.name == name }
+  val sessionKeySupported = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+    availableSessionKeys.any { it.name == name }
+  } else {
+    false
+  }
+  return requestKeySupported || sessionKeySupported
+}
+
+private fun getVideoStabilizationRequestMode(
+  availableModes: IntArray?,
+  requestedMode: VideoStabilizationMode
+): Int? {
+  if (availableModes == null) return null
+  if (!requestedMode.isAtLeast(VideoStabilizationMode.STANDARD)) {
+    return if (availableModes.contains(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_OFF)) {
+      CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_OFF
+    } else {
+      null
+    }
+  }
+
+  val supportsPreviewStabilization = Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+    availableModes.contains(CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_PREVIEW_STABILIZATION)
+  if (requestedMode.isAtLeast(VideoStabilizationMode.CINEMATIC_EXTENDED) && supportsPreviewStabilization) {
+    return CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_PREVIEW_STABILIZATION
+  }
