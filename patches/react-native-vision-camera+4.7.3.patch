+            "uniform samplerExternalOES %2$s;\n" +
+            "uniform float uAlphaScale;\n" +
+            "uniform float uPeakingEnabled;\n" +
+            "uniform float uPeakingSensitivity;\n" +
+            "uniform float uTexelWidth;\n" +
+            "uniform float uTexelHeight;\n" +
+            "float luma(vec3 color) {\n" +
+            "  return dot(color, vec3(0.299, 0.587, 0.114));\n" +
+            "}\n" +
+            "void main() {\n" +
+            "  vec2 uv = %1$s;\n" +
+            "  vec4 src = texture2D(%2$s, uv);\n" +
+            "  if (uPeakingEnabled < 0.5) {\n" +
+            "    gl_FragColor = vec4(src.rgb, src.a * uAlphaScale);\n" +
+            "    return;\n" +
+            "  }\n" +
+            "  vec2 dx = vec2(uTexelWidth, 0.0);\n" +
+            "  vec2 dy = vec2(0.0, uTexelHeight);\n" +
+            "  float c = luma(src.rgb);\n" +
+            "  float tl = luma(texture2D(%2$s, uv - dx - dy).rgb);\n" +
+            "  float tr = luma(texture2D(%2$s, uv + dx - dy).rgb);\n" +
+            "  float bl = luma(texture2D(%2$s, uv - dx + dy).rgb);\n" +
+            "  float br = luma(texture2D(%2$s, uv + dx + dy).rgb);\n" +
+            "  float l = luma(texture2D(%2$s, uv - dx).rgb);\n" +
+            "  float r = luma(texture2D(%2$s, uv + dx).rgb);\n" +
+            "  float t = luma(texture2D(%2$s, uv - dy).rgb);\n" +
+            "  float b = luma(texture2D(%2$s, uv + dy).rgb);\n" +
+            "  float mean = (tl + t + tr + l + r + bl + b + br) * 0.125;\n" +
+            "  float localContrast = (abs(tl - mean) + abs(t - mean) + abs(tr - mean) + abs(l - mean) + abs(r - mean) + abs(bl - mean) + abs(b - mean) + abs(br - mean)) * 0.125;\n" +
