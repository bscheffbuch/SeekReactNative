@@ -0,0 +1,36 @@
+package com.visioncameraplugininatvision;
+
+import java.io.IOException;
+
+/**
+ * One image classifier per process, shared by the camera frame processor and the
+ * gallery/photo module. Large models (e.g. BioCLIP 2, ~400 MB) were otherwise loaded
+ * twice while the camera screen was open, and the gallery path created (and never
+ * closed) a new interpreter, GPU delegate and taxonomy for every photo.
+ *
+ * Callers hold {@link #LOCK} for the whole get + configure + classify sequence: the
+ * interpreter is not thread-safe and filters / geomodel scores are per call.
+ */
+final class SharedImageClassifier {
+    static final Object LOCK = new Object();
+
+    private static ImageClassifier sClassifier;
+    private static String sKey;
+
+    private SharedImageClassifier() {}
+
+    /** Returns the classifier for these files, (re)loading it if they changed. Call with LOCK held. */
+    static ImageClassifier get(String modelPath, String taxonomyPath, String version) throws IOException {
+        String key = modelPath + "|" + taxonomyPath + "|" + version;
+        if (sClassifier != null && !key.equals(sKey)) {
+            sClassifier.close();
+            sClassifier = null;
+            sKey = null;
+        }
+        if (sClassifier == null) {
+            sClassifier = new ImageClassifier(modelPath, taxonomyPath, version);
+            sKey = key;
+        }
+        return sClassifier;
+    }
+}
