+package com.visioncameraplugininatvision;
+
+import android.content.Context;
+import android.content.res.AssetFileDescriptor;
+
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.MappedByteBuffer;
+import java.nio.channels.FileChannel;
+
+/**
+ * Opens model and taxonomy files from either a file path or, for paths starting with
+ * "asset:/", directly from the APK. A model stored uncompressed in the APK can be
+ * memory-mapped in place, so large bundled models (e.g. a ~400 MB BioCLIP 2 pack)
+ * don't need a second copy in app storage.
+ */
+final class ModelFiles {
+    static final String ASSET_PREFIX = "asset:/";
+    private static Context sAppContext;
+
+    private ModelFiles() {}
+
+    static void init(Context context) {
+        if (context != null) {
+            sAppContext = context.getApplicationContext();
+        }
+    }
+
+    private static String assetName(String path) throws IOException {
+        if (sAppContext == null) {
+            throw new IOException("No context to open " + path);
+        }
+        return path.substring(ASSET_PREFIX.length());
+    }
+
+    static MappedByteBuffer map(String path) throws IOException {
+        if (path.startsWith(ASSET_PREFIX)) {
+            try (AssetFileDescriptor fd = sAppContext == null ? null : sAppContext.getAssets().openFd(assetName(path));
+                 FileInputStream in = new FileInputStream(fd.getFileDescriptor())) {
+                return in.getChannel().map(FileChannel.MapMode.READ_ONLY, fd.getStartOffset(), fd.getDeclaredLength());
+            }
+        }
+        try (FileInputStream in = new FileInputStream(path)) {
+            return in.getChannel().map(FileChannel.MapMode.READ_ONLY, 0, in.getChannel().size());
+        }
+    }
+
+    static InputStream open(String path) throws IOException {
+        if (path.startsWith(ASSET_PREFIX)) {
+            return sAppContext.getAssets().open(assetName(path));
+        }
+        return new FileInputStream(path);
+    }
+}
